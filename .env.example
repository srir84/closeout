# Copy to .env to change a setting. Defaults work for the demo.
# replay (default, no AI downloads) | light (1 local model) | full (2 local models) | hosted
CLOSEOUT_MODE=replay
# 1 = real time. The demo uses 17280 (1 day = 5 s). Restart tests use 1440 (1 day = 60 s).
CLOSEOUT_TIME_SCALE=17280
# Local models (light / full modes) run in Ollama on this computer.
OLLAMA_URL=http://host.docker.internal:11434
READER_A=qwen3-vl:4b-instruct
READER_B=qwen3-vl:8b-instruct
# Hosted mode only. It sends document images to an outside company: made-up documents only.
HOSTED_API_KEY=
HOSTED_MODEL=
